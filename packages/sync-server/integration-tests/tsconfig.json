{
  // Typechecked by sync-server's `typecheck` script. Separate from
  // sync-server's own tsconfig so these files can be strict and use Node's
  // newer APIs without changing how the server itself is checked.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "build",
    "tsBuildInfoFile": "build/.tsbuildinfo"
  },
  "references": [{ "path": "../../crdt" }, { "path": ".." }],
  "include": ["src/**/*", "vitest.config.ts", "vitest.globalSetup.ts"],
  "exclude": ["node_modules", "build"]
}
